# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=JOOUST_voting

# JWT
JWT_SECRET=replace_with_a_strong_secret

# Initial super-admin bootstrap
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password

# Email verification (SMTP)
# Leave these blank during development to keep email delivery disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Blockchain
HARDHAT_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=replace_with_private_key
VOTING_CONTRACT_ADDRESS=replace_with_contract_address

# App
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173
